//- local vars
block vars
	- var bodyClass = ''
	- var active = active || ''

doctype
//if IE 8
	html.no-js.lt-ie9
// [if gt IE 8] <!
html.no-js
	// <![endif]

	head
		block header
			meta(charset='utf-8')
			meta(http-equiv='X-UA-Compatible', content='IE=edge')
			if active == 'Index'
				title LP/EP Finder
			else
				title #{active} | LP/EP Finder
			meta(name='description', content='Lp/EP Finder, get any record from the best online vinyl stores')
			meta(name='viewport', content='width=device-width')
			link(href='http://fonts.googleapis.com/css?family=Roboto:400,400italic,500,500italic,300,300italic' rel='stylesheet' type='text/css')

			link(rel="apple-touch-icon", sizes="57x57", href="/apple-touch-icon-57x57.png")
