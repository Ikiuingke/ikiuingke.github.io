block vars
	- var active = 'Index'
	- var bodyClass = ''

extends templates/layout

block outlet
	h2 About

	p Lp/EP Finder is a vinyl search engine that helps you find the vinyls you are looking for in record shops arround the world or close to you.

	h2 Selected vinyl stores

	ul
		li
			a.Stores(href="http://clone.nl") clone.nl  (netherlands)
			p Dutch record label and shop specializing in experimental/underground electronic dance music.
		li
			a.Stores(href="https://oye-records.com/") oye-records.com  (germany)
			p Oye Records houses a fantastic range of music. Mostly devoted to house and disco there is also enough hip hop, jazz, and brand new electronic 12-inches.
		li
			a.Stores(href="https://hardwax.com/") hardwax.com  (germany)
			p Hard Wax is one of the world's leading shops for cutting-edge electronic dance music, such as techno, house, dub and bass music.
		li
			a.Stores(href="http://spacehall.de/shop/content") spacehall.de  (germany)
			p record store in Berlin, sounds, labels, mp3, records.
		li
			a.Stores(href="http://deejay.de") deejay.de  (germany)
			p Specialises in dance 12" vinyl with lots of classic, daily new releases and large stock. Shipping worldwide.
		li
			a.Stores(href="http://roughtrade.com") roughtrade.com  (uk)
			p Purchase the latest LPs from this online shop. With new releases, charts and a searchable catalogue.
		li
			a.Stores(href="http://rushhour.nl") rushhour.nl  (netherlands)
			p Online shopping from the earth's best selection of music, records, rare records collectable records, dvd's, books, magazines, videos, electronics, apparel & DJ ...
		li
			a.Stores(href="http://www.piccadillyrecords.com/*") piccadillyrecords.com  (uk)
			p Born in 1978, Piccadilly Records is an independent record shop in the heart of Manchester city centre.
		li
			a.Stores(href="http://www.phonicarecords.com/*") phonicarecords.com  (uk)
			p London's leading Vinyl Records Specialist based in Soho, London W1.
