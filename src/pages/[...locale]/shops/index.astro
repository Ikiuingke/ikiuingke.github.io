---
import Base from '../../../layouts/Base.astro';
import CountryList from '../../../components/CountryList.astro';
import config from '../../../../data/config.json';
import { t, localeParams, number } from '../../../lib/i18n.js';
import { catalog } from '../../../lib/catalog.js';

export const getStaticPaths = localeParams;
const { lang } = Astro.props;
const c = catalog();
const vars = { shops: number(lang, c.visible.length), countries: number(lang, c.countries.length) };
---
<Base lang={lang} path="/shops/" title={`${t(lang, 'shopsTitle')} · ${config.name}`} description={t(lang, 'shopsIntro', vars)}>
  <h1>{t(lang, 'shopsTitle')}</h1>
  <p>{t(lang, 'shopsIntro', vars)}</p>
  <CountryList lang={lang} countries={c.countries} />
</Base>
